# ===== Fill these six values, nothing else is needed =====

# Your domain pointing to this VPS (A record), e.g. inventory.powersourcetrading.com
DOMAIN=inventory.example.com

# Database password. Any long random string. Generate: openssl rand -hex 16
DB_PASSWORD=CHANGE_ME_DB

# App secret. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_SECRET

# Public URL of the app, with https and your domain
BETTER_AUTH_URL=https://inventory.example.com

# First admin account. Created automatically on first start.
ADMIN_EMAIL=admin@powersourcetrading.com
ADMIN_PASSWORD=CHANGE_ME_STRONG
ADMIN_NAME=PST Admin
